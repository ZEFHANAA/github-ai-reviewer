# ---------------------------------------------------------------------------
# GitHub AI Reviewer — environment configuration
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# PRODUCTION: never commit .env; APP_ENV=production, APP_DEBUG=false,
# generate a fresh APP_KEY (php artisan key:generate), and set the secrets
# in the "Provider credentials" section. See docs/DEPLOYMENT.md for the
# full deployment reference.
# ---------------------------------------------------------------------------

# Core application ----------------------------------------------------------
APP_NAME="GitHub AI Reviewer"

# Environment: local | production | testing. In any environment other than
# "local", APP_DEBUG is forced off by the application's boot guard, so a
# production deploy can never leak debug stack traces even if this flag is
# misconfigured.
APP_ENV=local

# Secret application key. REQUIRED. Generate with: php artisan key:generate
# This is the single most important secret — rotating it invalidates sessions
# and encrypted data. Never reuse the local value in production.
APP_KEY=

# Debug mode exposes exception stack traces and detailed error pages.
# Never true in production.
APP_DEBUG=true

# Canonical public origin, e.g. https://your-app.example.com. Used to build
# absolute URLs (redirects, generated links) behind a proxy/CDN.
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Provider credentials (server-side secrets — store on the host, never commit)
# ---------------------------------------------------------------------------

# Optional server-side GitHub token. Raises the GitHub REST API rate limit
# well above the anonymous 60 req/hour. Works with unauthenticated public
# repository analysis; no OAuth required.
GITHUB_TOKEN=

# AI review (optional enrichment). Leave provider=fake to disable network calls.
# provider: fake | a configured OpenAI-compatible provider id
AI_PROVIDER=fake
# OpenAI-compatible base URL, e.g. https://api.openai.com/v1
AI_BASE_URL=
# Provider endpoint, usually chat/completions
AI_ENDPOINT=chat/completions
# Provider model name, e.g. gpt-4o-mini
AI_MODEL=
# Server-side provider API key — redacted from failure logs automatically
AI_API_KEY=
# Request timeout seconds. Valid range: 5-120; out-of-range values are clamped.
AI_TIMEOUT=30

# ---------------------------------------------------------------------------
# Localization
# ---------------------------------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
#
# PRODUCTION: set LOG_CHANNEL=stderr (or a log aggregation/driver) and
# LOG_LEVEL=warning so application errors go to the host's stdout/stderr and
# are picked up by the platform's log collector. "single" writes to a file,
# which is ephemeral on containerized/immutable deploys.
# ---------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database
#
# Default is SQLite (zero setup, file-backed, ideal for local dev and for a
# single-instance deploy with a persistent volume for database/database.sqlite).
#
# PRODUCTION options:
#   - SQLite + persistent disk: zero config, but single-writer (low concurrency)
#     and the volume must be mounted at database/database.sqlite.
#   - PostgreSQL / MySQL: recommended for multi-user production. Set
#     DB_CONNECTION=pgsql|mysql plus DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
#     The pdo_pgsql / pdo_mysql PHP extension must be installed in the container.
# See docs/DEPLOYMENT.md -> "Database" for the recommendation and trade-offs.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite

# SQLite only: absolute or project-relative path to the database file.
# For a persistent-volume deploys point this INSIDE the mounted volume.
# DB_DATABASE=/var/app/database/database.sqlite

# PostgreSQL / MySQL only (override when DB_CONNECTION=pgsql|mysql):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=github_ai_reviewer
# DB_USERNAME=app
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session & cache
#
# Both default to the database, which is convenient on a single instance with
# one persistent DB. On multi-instance deploys move both to a shared store
# (Redis) so sessions/cache are not spread across machines.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Force HTTPS-only session cookies in production (behind a TLS-terminating proxy):
SESSION_SECURE_COOKIE=false
# SameSite=lax is the safe default; strict further reduces CSRF surface.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# PRODUCTION queue: keep QUEUE_CONNECTION=database (uses the same persistent DB)
# or switch to redis if you run a Redis instance. Do NOT use "sync" in prod —
# it blocks the web request until the job completes.
CACHE_STORE=database
# CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Third-party services (unused by this app unless a feature references them)
# ---------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
